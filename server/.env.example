# คัดลอกเป็น server/.env แล้วแก้ค่า (ไฟล์ .env ไม่เก็บใน git)
PORT=3100

# MySQL (docker-compose.yml สร้างให้ที่พอร์ต 3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=cargo
DB_USER=cargo
DB_PASSWORD=เปลี่ยนเป็นรหัสผ่านยาว ๆ
DB_ROOT_PASSWORD=เปลี่ยนเป็นรหัสผ่านยาว ๆ อีกอัน

# ผู้ดูแลระบบถาวร (คั่นด้วย ,)
ADMIN_EMAILS=phatthachada.k@gmail.com

# URL สาธารณะ (เช่น Cloudflare) ใช้แสดง API_URL ให้ ESP32 ว่าง = ใช้ที่อยู่ที่เปิดหน้าเว็บ
PUBLIC_BASE_URL=

# Continue with Google ผ่านแอปยืนยันตัวตน gas-login (ค่าเดียวกับ gas-login/Secret.gs)
# ใน gas-login/Secret.gs ตั้ง MAIN_APP_URL เป็น URL สาธารณะของเซิร์ฟเวอร์นี้
LOGIN_SECRET=
LOGIN_APP_URL=

# Google Sign-In ด้วย Client ID (ตั้งจากหน้าผู้ดูแลระบบได้ ไม่ต้องใส่ที่นี่)
GOOGLE_CLIENT_ID=

# 1 = ยอมให้เข้าด้วยอีเมลอย่างเดียว (ไม่มีรหัสผ่าน) ตอนยังไม่ได้ตั้ง Google ใช้เฉพาะทดลองในเครื่อง
EMAIL_ONLY_LOGIN=0
SESSION_DAYS=365
